<Window x:Class="RCL.Dialogs.FastFlagDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加 FastFlag" Width="580" Height="560" SizeToContent="Manual"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource AppFont}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="FFlagTab" TargetType="RadioButton">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" Padding="16,9" CornerRadius="4,4,0,0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushAccentDark}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Margin="16" Background="{DynamicResource BrushCard}" CornerRadius="8"
            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.22" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="4"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource BrushTitleBar}" CornerRadius="8,8,0,0"/>
            <Grid Grid.Row="1" Margin="22,16,16,0" Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="添加 FastFlag" Style="{StaticResource SectionTitle}" FontSize="15"
                           VerticalAlignment="Center"/>
                <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Width="26" Height="26"
                        Click="Cancel_Click" ToolTip="关闭">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                               Foreground="{DynamicResource BrushTextSecondary}"/>
                </Button>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="22,12,22,0">
                <RadioButton x:Name="TabSingle" Content="添加单项" Style="{StaticResource FFlagTab}"
                             GroupName="FFlagTabs" IsChecked="True" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabJson" Content="导入 JSON" Style="{StaticResource FFlagTab}"
                             GroupName="FFlagTabs" Checked="Tab_Checked"/>
            </StackPanel>
            <Border Grid.Row="2" Height="1" Background="{DynamicResource BrushBorder}" VerticalAlignment="Bottom"
                    Margin="22,0,22,0"/>

            <Grid Grid.Row="3" Margin="22,18,22,0">
                <StackPanel x:Name="PanelSingle">
                    <TextBlock Text="Flag 名称" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                    <TextBox x:Name="NameBox" Style="{StaticResource PclTextBox}" FontFamily="Consolas"
                             FontSize="12" Height="32" TextChanged="NameBox_TextChanged"/>
                    <TextBlock x:Name="NameHint" Style="{StaticResource TinyText}" Margin="0,5,0,0"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="值（JSON）" Style="{StaticResource MutedText}" Margin="0,14,0,6"/>
                    <TextBox x:Name="ValueBox" Style="{StaticResource PclTextBox}" FontFamily="Consolas"
                             FontSize="12" Height="32" Text="true" TextChanged="ValueBox_TextChanged"/>
                    <TextBlock Style="{StaticResource TinyText}" Margin="0,6,0,0"
                               Text="数字 / true / false / &quot;文本&quot;，例如 240、true、&quot;None&quot;。"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,20,0,0" TextWrapping="Wrap"
                               Text="添加后会自动写入当前实例的 ClientAppSettings.json；启动实例时再应用到所选 Roblox 版本目录。"/>
                </StackPanel>

                <Grid x:Name="PanelJson" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="直接粘贴一个 JSON 对象，支持一次导入多条 Flag。" Style="{StaticResource MutedText}"
                               Margin="0,0,0,8"/>
                    <Grid Grid.Row="1" Height="240">
                        <TextBox x:Name="JsonBox" Style="{StaticResource PclTextBox}" AcceptsReturn="True"
                                 TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 Padding="10,8" VerticalContentAlignment="Top" TextChanged="JsonBox_TextChanged"/>
                        <TextBlock x:Name="JsonHint" IsHitTestVisible="False" Margin="12,10,0,0"
                                   VerticalAlignment="Top" FontFamily="Consolas" FontSize="12"
                                   Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap"
                                   Text="{}{&#x0a;  &quot;FFlagDebugDisplayFPS&quot;: &quot;True&quot;&#x0a;}"/>
                    </Grid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="从文件导入" Style="{StaticResource SmallButton}" Height="28"
                                Click="ImportFile_Click"/>
                        <Button Content="从剪贴板粘贴" Style="{StaticResource GhostButton}" Height="28"
                                Margin="6,0,0,0" Click="Paste_Click"/>
                    </StackPanel>
                    <TextBlock Grid.Row="3" Style="{StaticResource TinyText}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="JSON 对象里的每个值都会原样写入，例如：{ &quot;DFIntTaskSchedulerTargetFps&quot;: 240 }。"/>
                </Grid>
            </Grid>

            <Grid Grid.Row="4" Margin="22,16,22,18">
                <TextBlock x:Name="ErrorText" Style="{StaticResource TinyText}"
                           Foreground="{DynamicResource BrushDanger}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Width="300" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{StaticResource GhostButton}" Height="32" MinWidth="82"
                            Margin="0,0,8,0" Click="Cancel_Click"/>
                    <Button Content="确定" Style="{StaticResource PrimaryButton}" Height="32" MinWidth="82"
                            Click="Ok_Click" IsDefault="True"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
