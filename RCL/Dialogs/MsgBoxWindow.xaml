<Window x:Class="RCL.Dialogs.MsgBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RCL" Width="440" SizeToContent="Height" MaxHeight="620"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource AppFont}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border Margin="16" Background="{DynamicResource BrushCard}" CornerRadius="8"
            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.22" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="4"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Height="4" Background="{DynamicResource BrushTitleBar}" CornerRadius="8,8,0,0"/>
            <StackPanel Grid.Row="1" Margin="22,18,22,18">
                <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">
                    <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitle}" FontSize="14.5"
                               VerticalAlignment="Center" Margin="0,0,30,0"/>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource IconButton}"
                            Width="26" Height="26" Click="Cancel_Click" ToolTip="关闭">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                    </Button>
                </Grid>
                <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Margin="0,12,0,0">
                    <TextBlock x:Name="MessageText" Style="{StaticResource BodyText}" LineHeight="20"
                               TextWrapping="Wrap"/>
                </ScrollViewer>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button x:Name="CancelButton" Content="取消" Style="{StaticResource PclButton}"
                            MinWidth="82" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True"/>
                    <Button x:Name="OkButton" Content="确定" Style="{StaticResource PrimaryButton}"
                            MinWidth="82" Click="Ok_Click" IsDefault="True"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
