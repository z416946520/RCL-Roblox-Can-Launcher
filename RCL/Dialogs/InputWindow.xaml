<Window x:Class="RCL.Dialogs.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RCL" Width="440" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource AppFont}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border Margin="16" Background="{DynamicResource BrushCard}" CornerRadius="8"
            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.22" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="4"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Height="4" Background="{DynamicResource BrushTitleBar}" CornerRadius="8,8,0,0"/>
            <StackPanel Grid.Row="1" Margin="22,18,22,18">
                <Grid Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitle}" FontSize="14.5"
                               VerticalAlignment="Center" Margin="0,0,30,0"/>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource IconButton}"
                            Width="26" Height="26" Click="Cancel_Click" ToolTip="关闭">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                    </Button>
                </Grid>

                <StackPanel Margin="0,16,0,0">
                    <TextBlock x:Name="LabelText" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                    <TextBox x:Name="Input" Style="{StaticResource PclTextBox}"/>
                    <TextBlock x:Name="HintText" Style="{StaticResource TinyText}" Margin="1,5,0,0"/>
                </StackPanel>

                <StackPanel x:Name="SecondPanel" Margin="0,12,0,0">
                    <TextBlock x:Name="SecondLabel" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                    <TextBox x:Name="Input2" Style="{StaticResource PclTextBox}"/>
                    <TextBlock x:Name="SecondHint" Style="{StaticResource TinyText}" Margin="1,5,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button Content="取消" Style="{StaticResource PclButton}" MinWidth="82" Margin="0,0,8,0"
                            Click="Cancel_Click" IsCancel="True"/>
                    <Button x:Name="OkButton" Content="确定" Style="{StaticResource PrimaryButton}" MinWidth="82"
                            Click="Ok_Click" IsDefault="True"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
