<Window x:Class="RCL.Dialogs.LaunchProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RCL" Width="560" Height="320"
        Icon="pack://application:,,,/RCL;component/Assets/RCL.ico"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="True" WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource AppFont}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border Margin="14" Background="{DynamicResource BrushCard}" CornerRadius="8"
            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.22" Color="#000000"/>
        </Border.Effect>
        <Grid Margin="22,14,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock x:Name="ChannelText" Style="{StaticResource TinyText}"/>
                <TextBlock x:Name="VersionText" Style="{StaticResource TinyText}" HorizontalAlignment="Right"/>
            </Grid>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image x:Name="LogoImage" Width="96" Height="96" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       HorizontalAlignment="Center"/>
                <TextBlock x:Name="StatusText" FontSize="15" Margin="0,22,0,0"
                           HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                           MaxWidth="470"/>
            </StackPanel>

            <ProgressBar Grid.Row="2" x:Name="Progress" Height="6" IsIndeterminate="True"
                         Margin="0,18,0,16" Foreground="{DynamicResource BrushAccent}"
                         Background="{DynamicResource BrushBorder}"/>

            <Button Grid.Row="3" x:Name="CancelButton" Content="取消" Width="120" Height="30"
                    Style="{StaticResource PclButton}" HorizontalAlignment="Center" Click="Cancel_Click"/>
        </Grid>
    </Border>
</Window>
