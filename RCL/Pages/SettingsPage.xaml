<UserControl x:Class="RCL.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFont}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource BrushSidebar}" BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="0,0,1,0">
            <StackPanel Margin="14,18,12,12">
                <TextBlock Text="设置" Style="{StaticResource PageTitle}" FontSize="18" Margin="2,0,0,12"/>
                <ListBox x:Name="NavList" Style="{StaticResource PclListBox}"
                         ItemContainerStyle="{StaticResource PclListItem}" SelectedIndex="0"
                         SelectionChanged="NavList_SelectionChanged">
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Center" Margin="0,1,9,0"/>
                            <TextBlock Text="启动" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Center" Margin="0,1,9,0"/>
                            <TextBlock Text="Roblox 账号" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Center" Margin="0,1,9,0"/>
                            <TextBlock Text="外观" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Center" Margin="0,1,9,0"/>
                            <TextBlock Text="集成" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Center" Margin="0,1,9,0"/>
                            <TextBlock Text="多开" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Center" Margin="0,1,9,0"/>
                            <TextBlock Text="数据与关于" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <!-- Launch settings -->
            <ScrollViewer x:Name="PanelLaunch" Style="{StaticResource PageScroll}">
                <StackPanel Margin="24,20,24,24">
                    <TextBlock Text="启动设置" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="控制每次启动时的确认与收尾行为。" Style="{StaticResource PageSubtitle}" Margin="0,4,0,16"/>

                    <Border Style="{StaticResource Card}" Padding="20,17,20,18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="行为" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                            <CheckBox x:Name="ConfirmCheck" Content="Roblox 已在运行时，启动前先询问"
                                      Style="{StaticResource PclCheckBox}" Margin="0,5" Click="Setting_Changed"/>
                            <CheckBox x:Name="CloseAfterCheck" Content="启动 Roblox 后关闭 RCL 窗口"
                                      Style="{StaticResource PclCheckBox}" Margin="0,5" Click="Setting_Changed"/>
                            <CheckBox x:Name="PlaytimeCheck" Content="记录实例游玩时长"
                                      Style="{StaticResource PclCheckBox}" Margin="0,5" Click="Setting_Changed"/>
                            <CheckBox x:Name="DefaultMultiCheck" Content="新建实例默认开启多开"
                                      Style="{StaticResource PclCheckBox}" Margin="0,5" Click="Setting_Changed"/>
                            <CheckBox x:Name="OptimizeCheck" Content="启动后优化 Roblox 进程（降低 CPU 优先级）"
                                      Style="{StaticResource PclCheckBox}" Margin="0,5" Click="Setting_Changed"/>
                            <StackPanel Orientation="Horizontal" Margin="26,2,0,0">
                                <TextBlock Text="工作集上限" Style="{StaticResource TinyText}" VerticalAlignment="Center"/>
                                <TextBox x:Name="MemoryLimitBox" Style="{StaticResource PclTextBox}" Width="64" Height="26"
                                         Margin="8,0,6,0" LostFocus="OptimizeValues_Changed"/>
                                <TextBlock Text="MB（0 = 不限）" Style="{StaticResource TinyText}" VerticalAlignment="Center"/>
                                <TextBlock Text="CPU 核心" Style="{StaticResource TinyText}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                <TextBox x:Name="CoresBox" Style="{StaticResource PclTextBox}" Width="52" Height="26"
                                         Margin="8,0,6,0" LostFocus="OptimizeValues_Changed"/>
                                <TextBlock Text="（0 = 不限）" Style="{StaticResource TinyText}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Roblox 客户端更新" Style="{StaticResource MutedText}" Margin="0,14,0,6"/>
                            <ComboBox x:Name="RobloxUpdateCombo" Style="{StaticResource PclComboBox}" Width="260"
                                      HorizontalAlignment="Left" SelectionChanged="RobloxUpdateMode_Changed">
                                <ComboBoxItem Content="启动前自动更新（立即）"/>
                                <ComboBoxItem Content="发现新版本后等一天再更新"/>
                                <ComboBoxItem Content="只手动更新"/>
                            </ComboBox>
                            <TextBlock Style="{StaticResource TinyText}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="只在实例未绑定固定版本时生效；Roblox 正在运行时会跳过本次检查。"/> 
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20,17,20,18">
                        <StackPanel>
                            <TextBlock Text="默认实例" Style="{StaticResource CardTitle}" Margin="0,0,0,6"/>
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,10"
                                       Text="下次打开 RCL 或点击快捷方式时优先显示的实例。"/>
                            <ComboBox x:Name="DefaultInstanceCombo" Style="{StaticResource PclComboBox}" Width="260"
                                      HorizontalAlignment="Left" DisplayMemberPath="Name"
                                      SelectionChanged="DefaultInstance_Changed"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20,17,20,18" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Roblox 链接接管" Style="{StaticResource CardTitle}"/>
                            <TextBlock x:Name="HandlerCurrentText" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                            <TextBlock x:Name="HandlerStatusText" Style="{StaticResource TinyText}" Margin="0,4,0,0"
                                       TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="TakeoverButton" Content="接管 Roblox 链接" Style="{StaticResource PrimaryButton}"
                                        Height="30" MinWidth="130" Click="Takeover_Click"/>
                                <Button x:Name="RestoreHandlerButton" Content="恢复原启动器" Style="{StaticResource PclButton}"
                                        Height="30" MinWidth="120" Margin="8,0,0,0" Click="RestoreHandler_Click"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource TinyText}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="接管后，点击网页上的 Roblox 链接会由 RCL 打开，并使用当前选择的账号。原处理程序会备份在 RCL 数据目录，可随时恢复。"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20,17,20,18" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="客户端安全" Style="{StaticResource CardTitle}" Margin="0,0,0,6"/>
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,10" TextWrapping="Wrap"
                                       Text="这里可以还原 RCL 写入的客户端修改；不会删除你的模组源文件。"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="还原 RCL 客户端修改" Style="{StaticResource PclButton}" Height="30"
                                        MinWidth="140" Click="RestoreClient_Click"/>
                                <Button Content="打开官方版本修复" Style="{StaticResource GhostButton}" Height="30"
                                        Margin="8,0,0,0" Click="OpenRepair_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="ClientSafetyStatus" Style="{StaticResource TinyText}" Margin="0,8,0,0"
                                       TextWrapping="Wrap" Text="尚未检查。还原前请先关闭所有 Roblox 客户端。"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Appearance -->
            <!-- Roblox accounts -->
            <ScrollViewer x:Name="PanelAccounts" Style="{StaticResource PageScroll}" Visibility="Collapsed">
                <StackPanel Margin="24,20,24,24">
                    <TextBlock Text="Roblox 账号" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="登录一次后，切换账号即可让所有实例使用对应账号启动。" Style="{StaticResource PageSubtitle}"
                               Margin="0,4,0,16"/>

                    <Border Style="{StaticResource Card}" Padding="18,15,18,16" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CurrentAccountAvatar" Width="52" Height="52" CornerRadius="26"
                                    Background="{DynamicResource BrushAccentSoft}" VerticalAlignment="Center">
                                <TextBlock x:Name="CurrentAccountInitial" Text="R" FontSize="19" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushAccentDark}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="CurrentAccountName" Text="未登录 Roblox" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock x:Name="CurrentAccountSub" Text="添加账号后，启动的实例会使用它"
                                           Style="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,0"/>
                                <TextBlock x:Name="CurrentAccountId" Style="{StaticResource TinyText}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <Button x:Name="RestoreCookieButton" Content="恢复启动前登录" Style="{StaticResource GhostButton}"
                                        Height="28" Click="RestoreCookie_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="18,15,18,16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="添加账号" Style="{StaticResource CardTitle}"/>
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,12"
                                       Text="推荐使用 Roblox 官方登录页登录。登录页面在 RCL 内置浏览器中打开，Cookie 只会保存在本机，并用 Windows DPAPI 加密。"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="AddAccountWebButton" Content="网页登录添加" Style="{StaticResource PrimaryButton}"
                                        Height="32" MinWidth="120" Click="AddAccountWeb_Click"/>
                                <Button x:Name="AddAccountCookieButton" Content="手动 Cookie 添加" Style="{StaticResource PclButton}"
                                        Height="32" MinWidth="130" Margin="8,0,0,0" Click="AddAccountCookie_Click"/>
                                <Button x:Name="RefreshAvatarsButton" Content="刷新头像" Style="{StaticResource GhostButton}"
                                        Height="32" Margin="8,0,0,0" Click="RefreshAvatars_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="AccountStatus" Style="{StaticResource TinyText}" Margin="0,10,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="18,15,18,16" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="已保存账号" Style="{StaticResource CardTitle}"/>
                                <Border Style="{StaticResource TagBorder}" HorizontalAlignment="Right">
                                    <TextBlock x:Name="AccountCountText" Text="0 个" Style="{StaticResource TagText}"/>
                                </Border>
                            </Grid>
                            <ItemsControl x:Name="AccountsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="46"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="38" Height="38" CornerRadius="19" VerticalAlignment="Center"
                                                    Background="{Binding AvatarCachePath, Converter={StaticResource PathToImageBrush}}">
                                                <TextBlock Text="{Binding Initial}" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource BrushAccentDark}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding HasAvatar, Converter={StaticResource InvBoolToVis}}"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Display}" FontSize="13" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <Border Style="{StaticResource TagBorder}" Background="#E8F5EC" Margin="7,0,0,0"
                                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="当前" FontSize="10" Foreground="#1F8A4C"/>
                                                    </Border>
                                                    <Border Style="{StaticResource TagBorder}" Background="#FDECEA" Margin="6,0,0,0"
                                                            Visibility="{Binding HasToken, Converter={StaticResource InvBoolToVis}}">
                                                        <TextBlock Text="需重新登录" FontSize="10" Foreground="#B33A2B"/>
                                                    </Border>
                                                    <Border Style="{StaticResource TagBorder}" Background="#FFF4E5" Margin="6,0,0,0"
                                                            Visibility="{Binding NeedsVerification, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="待验证" FontSize="10" Foreground="#A86500"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource TinyText}" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="切换" Style="{StaticResource SmallButton}"
                                                    Height="27" MinWidth="54" Margin="8,0,0,0" IsEnabled="{Binding HasToken}"
                                                    Tag="{Binding}" Click="SwitchAccount_Click"/>
                                            <Button Grid.Column="3" Content="移除" Style="{StaticResource GhostButton}"
                                                    Height="27" MinWidth="54" Margin="4,0,0,0"
                                                    Tag="{Binding}" Click="RemoveAccount_Click"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="AccountsEmpty" Style="{StaticResource MutedText}" Margin="0,12,0,4"
                                       Text="还没有保存账号。用上面的「网页登录添加」开始。"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Background="{DynamicResource BrushWarningSoft}"
                            BorderBrush="#F6D9A6" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="Cookie 安全" FontSize="12.5" FontWeight="SemiBold" Foreground="#9A6200"/>
                            <TextBlock FontSize="11.5" Foreground="#9A6200" Margin="0,3,0,0" TextWrapping="Wrap" LineHeight="18"
                                       Text=".ROBLOSECURITY 等同于账号登录凭据，不要发给任何人。RCL 只在本机用 Windows DPAPI 加密保存，并在启动 Roblox 前写入官方 Cookie 文件；切换账号会影响之后启动的所有客户端。"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="PanelAppearance" Style="{StaticResource PageScroll}" Visibility="Collapsed">
                <StackPanel Margin="24,20,24,24">
                    <TextBlock Text="外观" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="沿用 PCL 的配色层级：主题色会同步到标题栏、按钮与选中态。" Style="{StaticResource PageSubtitle}"
                               Margin="0,4,0,16"/>

                    <Border Style="{StaticResource Card}" Padding="20,17,20,18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="界面语言" Style="{StaticResource CardTitle}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="LanguageCombo" Style="{StaticResource PclComboBox}" Width="220"
                                      HorizontalAlignment="Left" SelectionChanged="Language_Changed">
                                <ComboBoxItem Content="简体中文"/>
                                <ComboBoxItem Content="English"/>
                            </ComboBox>
                            <TextBlock x:Name="LanguageHint" Style="{StaticResource TinyText}" Margin="0,6,0,0"
                                       Text="切换后重启 RCL 生效。英文界面覆盖主要文案，动态状态提示仍可能显示中文。"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20,17,20,18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="主题" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                            <CheckBox x:Name="DarkModeCheck" Content="深色模式" Style="{StaticResource PclCheckBox}"
                                      Margin="0,2,0,10" Click="DarkMode_Changed"/>
                            <TextBlock Text="主题预设" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="PresetCombo" Style="{StaticResource PclComboBox}" Width="240"
                                      HorizontalAlignment="Left" SelectionChanged="Preset_Changed"/>
                            <TextBlock Style="{StaticResource TinyText}" Margin="0,8,0,0"
                                       Text="预设会同时设置主题色与深色/浅色；也可以在上面自己调色。"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20,17,20,18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="主题色" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>
                            <StackPanel x:Name="AccentPalette" Orientation="Horizontal" Margin="0,0,0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="自定义" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                                <TextBox x:Name="AccentHexBox" Grid.Column="1" Style="{StaticResource PclTextBox}"
                                         Width="140" HorizontalAlignment="Left" FontFamily="Consolas"/>
                                <Button Grid.Column="2" Content="应用颜色" Style="{StaticResource SmallButton}" Height="30"
                                        Click="ApplyAccent_Click"/>
                            </Grid>
                            <TextBlock x:Name="AccentStatus" Style="{StaticResource TinyText}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20,17,20,18">
                        <StackPanel>
                            <TextBlock Text="背景图" Style="{StaticResource CardTitle}" Margin="0,0,0,6"/>
                            <TextBlock x:Name="BackgroundPathText" Style="{StaticResource TinyText}"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="选择图片…" Style="{StaticResource PclButton}" Height="30" Click="PickBackground_Click"/>
                                <Button Content="清除背景" Style="{StaticResource GhostButton}" Height="30" Margin="8,0,0,0"
                                        Click="ClearBackground_Click"/>
                                <TextBlock Text="不透明度" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                           Margin="18,0,8,0"/>
                                <ComboBox x:Name="OpacityCombo" Style="{StaticResource PclComboBox}" Width="100" Height="30"
                                          SelectionChanged="Opacity_Changed"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource TinyText}" Margin="0,10,0,0"
                                       Text="背景图会铺在页面内容下方；内容区域保持半透明白色以保证可读性。"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="铺放方式" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <ComboBox x:Name="FitCombo" Style="{StaticResource PclComboBox}" Width="110" Height="30"
                                          SelectionChanged="Fit_Changed">
                                    <ComboBoxItem Content="填充"/>
                                    <ComboBoxItem Content="适应"/>
                                    <ComboBoxItem Content="居中"/>
                                </ComboBox>
                                <TextBlock Text="暗化" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                           Margin="18,0,8,0"/>
                                <ComboBox x:Name="DimCombo" Style="{StaticResource PclComboBox}" Width="110" Height="30"
                                          SelectionChanged="Dim_Changed">
                                    <ComboBoxItem Content="不暗化"/>
                                    <ComboBoxItem Content="25%"/>
                                    <ComboBoxItem Content="50%"/>
                                    <ComboBoxItem Content="70%"/>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Integrations -->
            <ScrollViewer x:Name="PanelIntegrations" Style="{StaticResource PageScroll}" Visibility="Collapsed">
                <StackPanel Margin="24,20,24,24">
                    <TextBlock Text="集成" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="把 RCL 的状态同步到 Discord；所有连接只在本机进行。" Style="{StaticResource PageSubtitle}"
                               Margin="0,4,0,16"/>

                    <Border Style="{StaticResource Card}" Padding="20,17,20,18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Discord Rich Presence" Style="{StaticResource CardTitle}"/>
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,12" LineHeight="19"
                                       Text="在 Discord 个人资料中显示当前实例和正在玩的游戏。需要先在 Discord 开发者门户创建一个应用（名称填 RCL），再把 Application ID 填到下面。"/>
                            <CheckBox x:Name="DiscordEnabledCheck" Content="启用 Discord 状态" Style="{StaticResource PclCheckBox}"
                                      FontSize="13" Click="DiscordEnabled_Click"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Application ID" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                                <TextBox x:Name="DiscordClientIdBox" Grid.Column="1" Style="{StaticResource PclTextBox}" Height="32"
                                         FontFamily="Consolas" Padding="9,4"/>
                                <Button Grid.Column="2" Content="应用" Style="{StaticResource PclButton}" Height="32" Margin="8,0,0,0"
                                        Click="DiscordApply_Click"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="测试连接" Style="{StaticResource PclButton}" Height="30" Click="DiscordTest_Click"/>
                                <Button Content="打开开发者门户" Style="{StaticResource GhostButton}" Height="30" Margin="8,0,0,0"
                                        Click="DiscordPortal_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="DiscordStatusText" Style="{StaticResource TinyText}" Margin="0,10,0,0"
                                       Text="未启用。填写 Application ID 并勾选启用后，启动游戏时才会显示状态。"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Background="{DynamicResource BrushAccentSoft}"
                            BorderBrush="{DynamicResource BrushAccentBorder}" Padding="20,15,20,15">
                        <StackPanel>
                            <TextBlock Text="说明" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushAccentDark}"/>
                            <TextBlock Style="{StaticResource MutedText}" FontSize="12" Foreground="#2E5F9E" Margin="0,4,0,0"
                                       LineHeight="19"
                                       Text="Application ID 只用于本机 Discord IPC，RCL 不会把它或你的账号信息上传到任何服务器。Discord 应用名称与图标就是状态卡片上显示的名称与图标。"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Multi instance -->
            <ScrollViewer x:Name="PanelMulti" Style="{StaticResource PageScroll}" Visibility="Collapsed">
                <StackPanel Margin="24,20,24,24">
                    <TextBlock Text="多开设置" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="RCL 使用单例互斥体 + 目录联接槽位，让多个 Roblox 客户端互不踢出。"
                               Style="{StaticResource PageSubtitle}" Margin="0,4,0,16"/>

                    <Border Style="{StaticResource Card}" Padding="20,17,20,18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="槽位" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="最大槽位数量" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                <TextBox x:Name="MaxSlotsBox" Grid.Column="1" Style="{StaticResource PclTextBox}" Width="80"
                                         Margin="12,0,0,0" FontFamily="Consolas"/>
                                <Button Grid.Column="2" Content="保存" Style="{StaticResource SmallButton}" Height="30"
                                        HorizontalAlignment="Left" Margin="10,0,0,0" Click="SaveSlots_Click"/>
                            </Grid>
                            <TextBlock x:Name="MultiStatusText" Style="{StaticResource TinyText}" Margin="0,10,0,0"
                                       TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="清理空闲槽位" Style="{StaticResource PclButton}" Height="30"
                                        Click="CleanupSlots_Click"/>
                                <Button Content="打开槽位目录" Style="{StaticResource GhostButton}" Height="30"
                                        Margin="8,0,0,0" Click="OpenSlots_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20,17,20,18">
                        <StackPanel>
                            <TextBlock Text="当前会话" Style="{StaticResource CardTitle}" Margin="0,0,0,6"/>
                            <TextBlock x:Name="SessionText" Style="{StaticResource MutedText}"/>
                            <Button Content="结束全部 RCL 会话" Style="{StaticResource DangerButton}" Height="30"
                                    HorizontalAlignment="Left" Margin="0,12,0,0" Click="KillAll_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Data & about -->
            <ScrollViewer x:Name="PanelAbout" Style="{StaticResource PageScroll}" Visibility="Collapsed">
                <StackPanel Margin="24,20,24,24">
                    <TextBlock Text="数据与关于" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="管理 RCL 的数据目录，查看版本与致谢。" Style="{StaticResource PageSubtitle}" Margin="0,4,0,16"/>

                    <Border Style="{StaticResource Card}" Padding="20,17,20,18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="数据" Style="{StaticResource CardTitle}" Margin="0,0,0,6"/>
                            <TextBlock x:Name="DataPathText" Style="{StaticResource TinyText}" TextTrimming="CharacterEllipsis"
                                       Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="打开数据目录" Style="{StaticResource PclButton}" Height="30"
                                        Click="OpenData_Click"/>
                                <Button Content="打开日志" Style="{StaticResource GhostButton}" Height="30"
                                        Margin="8,0,0,0" Click="OpenLog_Click"/>
                                <Button Content="备份配置…" Style="{StaticResource PclButton}" Height="30"
                                        Margin="8,0,0,0" Click="Backup_Click"/>
                                <Button Content="导出诊断包" Style="{StaticResource GhostButton}" Height="30"
                                        Margin="8,0,0,0" Click="Diagnostics_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20,17,20,18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="更新" Style="{StaticResource CardTitle}"/>
                            <TextBlock x:Name="UpdateCurrentText" Style="{StaticResource MutedText}" Margin="0,4,0,10"/>
                            <TextBlock Text="更新方式" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="UpdateModeCombo" Style="{StaticResource PclComboBox}" Width="260"
                                      HorizontalAlignment="Left" SelectionChanged="UpdateMode_Changed">
                                <ComboBoxItem Content="自动：发现新版本就下载并重启"/>
                                <ComboBoxItem Content="提示：发现新版本先询问"/>
                                <ComboBoxItem Content="手动：只在设置里检查"/>
                            </ComboBox>
                            <TextBlock Text="GitHub 仓库（默认更新源）" Style="{StaticResource MutedText}" Margin="0,12,0,6"/>
                            <TextBox x:Name="GitHubRepoBox" Style="{StaticResource PclTextBox}" Height="32" Padding="9,4"
                                     FontFamily="Consolas"/>
                            <TextBlock Text="更新源（JSON 清单地址，留空时使用上面的 GitHub 仓库）" Style="{StaticResource MutedText}" Margin="0,12,0,6"/>
                            <TextBox x:Name="UpdateUrlBox" Style="{StaticResource PclTextBox}" Height="32" Padding="9,4"
                                     FontFamily="Consolas"/>
                            <TextBlock Style="{StaticResource TinyText}" Margin="0,6,0,0"
                                       Text="GitHub 模式读取 Releases 里的 RCL.exe；清单模式至少包含 version、url、sha256。"/> 
                            <CheckBox x:Name="UpdateStartupCheck" Content="启动时检查更新" Style="{StaticResource PclCheckBox}"
                                      Margin="0,10,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="UpdateCheckButton" Content="保存并检查" Style="{StaticResource PclButton}"
                                        Height="30" Click="CheckUpdates_Click"/>
                                <Button x:Name="UpdateInstallButton" Content="下载并安装" Style="{StaticResource PrimaryButton}"
                                        Height="30" Margin="8,0,0,0" Visibility="Collapsed" Click="InstallUpdate_Click"/>
                            </StackPanel>
                            <ProgressBar x:Name="UpdateProgress" Height="4" Margin="0,12,0,0" Minimum="0" Maximum="100"
                                         Visibility="Collapsed"/>
                            <TextBlock x:Name="UpdateStatusText" Style="{StaticResource TinyText}" Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20,17,20,18" Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" Background="{DynamicResource BrushAccent}" CornerRadius="7">
                                    <TextBlock Text="R" Foreground="White" FontSize="20" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="AboutVersion" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="PCL 风格 Roblox 启动器 · 实例隔离 · 多开 · FastFlags · 模组"
                                               Style="{StaticResource TinyText}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <Border Style="{StaticResource Divider}"/>
                            <TextBlock Style="{StaticResource MutedText}" LineHeight="19"
                                       Text="RCL 的界面语言来自 PCL-CE（Plain Craft Launcher Community Edition），启动与多开机制参考 Voidstrap，模组 / FastFlags 体验参考 Froststrap。所有启动器实现均为独立重写，不包含其代码或其资源。"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="PCL-CE" Style="{StaticResource GhostButton}" Height="28" Padding="8,0"
                                        Click="OpenPcl_Click"/>
                                <Button Content="Voidstrap" Style="{StaticResource GhostButton}" Height="28" Padding="8,0"
                                        Margin="4,0,0,0" Click="OpenVoidstrap_Click"/>
                                <Button Content="Froststrap" Style="{StaticResource GhostButton}" Height="28" Padding="8,0"
                                        Margin="4,0,0,0" Click="OpenFroststrap_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20,17,20,18">
                        <StackPanel>
                            <TextBlock Text="重置" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,10"
                                       Text="恢复默认启动设置、主题色与背景；实例数据不会被删除。"/>
                            <Button Content="重置所有设置" Style="{StaticResource DangerButton}" Height="30"
                                    HorizontalAlignment="Left" Click="ResetSettings_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
