<UserControl x:Class="RCL.Pages.InstancesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFont}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="292"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: instance list -->
        <Border Grid.Column="0" Background="{DynamicResource BrushSidebar}" BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="0,0,1,0">
            <Grid Margin="14,18,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="2,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="实例管理" Style="{StaticResource PageTitle}" FontSize="18"/>
                        <Border Style="{StaticResource TagBorder}" Margin="8,2,0,0">
                            <TextBlock x:Name="InstanceCountText" Text="0" Style="{StaticResource TagText}"/>
                        </Border>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Width="26" Height="26"
                            Click="NewInstance_Click" ToolTip="新建实例">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                    </Button>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <TextBox x:Name="SearchBox" Style="{StaticResource PclTextBox}" Height="32"
                             TextChanged="SearchBox_TextChanged" Padding="9,4"/>
                    <TextBlock x:Name="SearchHint" Text="搜索实例…" Margin="11,0,0,0" VerticalAlignment="Center"
                               FontSize="12.5" Foreground="{DynamicResource BrushTextMuted}" IsHitTestVisible="False"/>
                </Grid>

                <ListBox x:Name="InstancesList" Grid.Row="2" Style="{StaticResource PclListBox}"
                         ItemContainerStyle="{StaticResource PclListItem}"
                         SelectionChanged="InstancesList_SelectionChanged" Margin="0,0,-4,0" Padding="0,0,4,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="6" VerticalAlignment="Center"
                                        Background="{Binding IconColor, Converter={StaticResource HexBrush}}">
                                    <TextBlock Text="{Binding Name, Converter={StaticResource FirstChar}}"
                                               Foreground="White" FontSize="13" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding PlaytimeDisplay}" FontSize="11"
                                               Foreground="{DynamicResource BrushTextMuted}" Margin="0,1,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="2" Style="{StaticResource TagBorder}" Margin="4,0,0,0"
                                        Background="#E8F5EC" Visibility="{Binding MultiInstance, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="多开" FontSize="10" Foreground="#1F8A4C"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="新建实例" Style="{StaticResource PrimaryButton}" Height="32" Click="NewInstance_Click"/>
                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="32" Height="32"
                            Margin="6,0,0,0" Click="DuplicateInstance_Click" ToolTip="复制实例">
                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="32" Height="32"
                            Margin="2,0,0,0" Click="DeleteInstance_Click" ToolTip="删除实例">
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="{DynamicResource BrushDanger}"/>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- Right -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="24,18,24,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="8" x:Name="HeaderIcon"
                        Background="{DynamicResource BrushAccent}" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderInitial" Text="R" Foreground="White" FontSize="18"
                               FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderName" Text="实例" FontSize="18" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="HeaderMeta" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,1,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource PclButton}" Height="30" Margin="0,0,6,0" Click="OpenFolder_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,1,6,0"/>
                            <TextBlock Text="打开目录"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Height="30" Click="Launch_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="White" VerticalAlignment="Center" Margin="0,1,6,0"/>
                            <TextBlock Text="启动" Foreground="White"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1"
                    Margin="24,0,24,0">
                <StackPanel Orientation="Horizontal" Height="38">
                    <RadioButton x:Name="TabOverview" Style="{StaticResource PclTab}" Tag="&#xE946;"
                                 Content="概览" GroupName="InstanceTabs" IsChecked="True" Checked="Tabs_Checked"/>
                    <RadioButton x:Name="TabFlags" Style="{StaticResource PclTab}" Tag="&#xE943;"
                                 Content="FastFlags" GroupName="InstanceTabs" Checked="Tabs_Checked"/>
                    <RadioButton x:Name="TabMods" Style="{StaticResource PclTab}" Tag="&#xE838;"
                                 Content="模组" GroupName="InstanceTabs" Checked="Tabs_Checked"/>
                    <RadioButton x:Name="TabLaunch" Style="{StaticResource PclTab}" Tag="&#xE768;"
                                 Content="启动" GroupName="InstanceTabs" Checked="Tabs_Checked"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2">
                <!-- Overview -->
                <ScrollViewer x:Name="PanelOverview" Style="{StaticResource PageScroll}">
                    <StackPanel Margin="24,18,24,24">
                        <Border Style="{StaticResource Card}" Padding="20,17,20,18" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="基本信息" Style="{StaticResource CardTitle}" Margin="0,0,0,14"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="实例名称" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" x:Name="NameBox" Style="{StaticResource PclTextBox}"
                                             MaxLength="40" TextChanged="NameBox_TextChanged"/>
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="标识颜色" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                    <StackPanel x:Name="ColorPalette" Grid.Column="1" Orientation="Horizontal"/>
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="备注" Style="{StaticResource MutedText}" VerticalAlignment="Top" Margin="0,8,0,0"/>
                                    <TextBox Grid.Column="1" x:Name="NotesBox" Style="{StaticResource PclTextBox}"
                                             Height="62" TextWrapping="Wrap" AcceptsReturn="True"
                                             VerticalContentAlignment="Top" Padding="9,7"
                                             TextChanged="NotesBox_TextChanged"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="20,17,20,18" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="版本与隔离" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="每个实例可以锁定一个 Roblox 版本" Style="{StaticResource TinyText}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,12"
                                           Text="留空时自动使用最新安装的版本；指定版本后，即使 Roblox 更新，这个实例也会继续使用旧版本目录。"/>
                                <ComboBox x:Name="VersionCombo" Style="{StaticResource PclComboBox}"
                                          SelectionChanged="VersionCombo_SelectionChanged"/>
                                <TextBox x:Name="VersionPathBox" Style="{StaticResource PclTextBox}" IsReadOnly="True"
                                         Margin="0,10,0,0" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="刷新版本列表" Style="{StaticResource SmallButton}" Click="RefreshVersions_Click"/>
                                    <Button Content="打开版本目录" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                                            Click="OpenVersionFolder_Click"/>
                                    <Button Content="创建独立副本…" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                                            Click="CloneVersion_Click" ToolTip="把当前版本复制到实例目录，做到文件级隔离"/>
                                </StackPanel>
                                <TextBlock x:Name="CloneVersionHint" Style="{StaticResource TinyText}" Margin="0,7,0,0"
                                           TextWrapping="Wrap"/>
                                <Border Style="{StaticResource Divider}" Margin="0,14,0,8"/>
                                <CheckBox x:Name="FollowExecutorCheck" Content="跟随执行器支持版本（WEAO）"
                                          Style="{StaticResource PclCheckBox}" Click="FollowExecutor_Changed"/>
                                <StackPanel x:Name="FollowOptionsPanel" Visibility="Collapsed">
                                    <ComboBox x:Name="FollowExecutorCombo" Style="{StaticResource PclComboBox}"
                                              Height="30" MaxWidth="330" HorizontalAlignment="Left" Margin="26,7,0,0"
                                              SelectionChanged="FollowExecutor_SelectionChanged"/>
                                    <StackPanel Orientation="Horizontal" Margin="26,7,0,0">
                                        <CheckBox x:Name="AutoDownloadCheck" Content="检测到新版本时自动下载并锁定"
                                                  Style="{StaticResource PclCheckBox}" FontSize="12" Click="AutoDownload_Changed"/>
                                        <Button Content="立即检查" Style="{StaticResource GhostButton}" Height="26"
                                                Margin="8,0,0,0" Click="CheckExecutorNow_Click"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock x:Name="FollowHint" Style="{StaticResource TinyText}" Margin="26,5,0,0"
                                           TextWrapping="Wrap"
                                           Text="开启后会按 WEAO 中执行器支持的 Roblox 版本自动锁定实例；下载新版本约 230 MB。"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="20,17,20,18" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="行为" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>
                                <CheckBox x:Name="MultiCheck" Content="允许与其他实例同时运行（多开）"
                                          Style="{StaticResource PclCheckBox}" Margin="0,4" Click="Behavior_Changed"/>
                                <CheckBox x:Name="ApplyModsCheck" Content="启动时把实例模组覆盖到 Roblox 版本目录"
                                          Style="{StaticResource PclCheckBox}" Margin="0,4" Click="Behavior_Changed"/>
                                <TextBlock Style="{StaticResource TinyText}" Margin="26,3,0,0"
                                           Text="覆盖前 RCL 会自动备份原始文件；可在「模组」页还原。"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="20,17,20,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="实例数据" Style="{StaticResource CardTitle}" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="DataPlaytime" Style="{StaticResource MutedText}"/>
                                    <TextBlock x:Name="DataLastPlayed" Style="{StaticResource MutedText}"/>
                                    <TextBlock x:Name="DataLastGame" Style="{StaticResource MutedText}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button Content="创建桌面快捷方式" Style="{StaticResource SmallButton}" Height="28"
                                            Click="Shortcut_Click"/>
                                    <Button Content="重置游玩时长" Style="{StaticResource SmallButton}" Height="28"
                                            Margin="0,6,0,0" Click="ResetPlaytime_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- FastFlags -->
                <ScrollViewer x:Name="PanelFlags" Style="{StaticResource PageScroll}" Visibility="Collapsed">
                    <StackPanel Margin="24,18,24,24">
                        <Border x:Name="FlagsWarning" Style="{StaticResource Card}" Background="{DynamicResource BrushWarningSoft}"
                                BorderBrush="#F6D9A6" Padding="15,11" Margin="0,0,0,12" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="FlagsWarningTitle" FontSize="12.5" FontWeight="SemiBold" Foreground="#9A6200"/>
                                <TextBlock x:Name="FlagsWarningText" FontSize="11.5" Foreground="#9A6200"
                                           TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="18,15,18,15">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="FastFlags" Style="{StaticResource CardTitle}"/>
                                        <Border Style="{StaticResource TagBorder}" Margin="8,0,0,0">
                                            <TextBlock x:Name="FlagCountText" Text="0 条" Style="{StaticResource TagText}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="只在启动时写入实例绑定的版本目录" Style="{StaticResource TinyText}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <TextBox x:Name="FlagSearch" Style="{StaticResource PclTextBox}" Height="30" Padding="9,3"
                                                 TextChanged="FlagSearch_TextChanged"/>
                                        <TextBlock x:Name="FlagSearchHint" Text="搜索 Flag…" Margin="11,0,0,0"
                                                   VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{DynamicResource BrushTextMuted}" IsHitTestVisible="False"/>
                                    </Grid>
                                    <Button Grid.Column="1" Content="添加 / 导入" Style="{StaticResource SmallButton}" Height="30"
                                            Margin="8,0,0,0" Click="AddFlag_Click"/>
                                    <ComboBox x:Name="PresetCombo" Grid.Column="2" Style="{StaticResource PclComboBox}"
                                              Height="30" MinWidth="130" Margin="8,0,0,0" DisplayMemberPath="Name"/>
                                    <Button Grid.Column="3" Content="应用预设" Style="{StaticResource SmallButton}" Height="30"
                                            Margin="6,0,0,0" Click="ApplyPreset_Click"/>
                                </Grid>

                                <Grid Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="从文件导入" Style="{StaticResource GhostButton}" Height="26" Padding="8,0"
                                                Click="ImportFlags_Click"/>
                                        <Button Content="从其他启动器导入" Style="{StaticResource GhostButton}" Height="26" Padding="8,0"
                                                Margin="4,0,0,0" Click="ImportOtherFlags_Click"/>
                                        <Button Content="导出" Style="{StaticResource GhostButton}" Height="26" Padding="8,0"
                                                Margin="4,0,0,0" Click="ExportFlags_Click"/>
                                        <Button Content="立即写入版本" Style="{StaticResource GhostButton}" Height="26" Padding="8,0"
                                                Margin="4,0,0,0" Click="WriteFlags_Click"/>
                                    </StackPanel>
                                    <TextBlock x:Name="FlagStatus" Style="{StaticResource TinyText}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Style="{StaticResource Divider}"/>

                                <ItemsControl x:Name="FlagsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24"/>
                                                    <ColumnDefinition Width="230"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Style="{StaticResource PclCheckBox}" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                          VerticalAlignment="Center" Click="FlagEnabled_Click"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontFamily="Consolas"
                                                           FontSize="11.5" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                                <TextBox Grid.Column="2" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource PclTextBox}" Height="27" MinHeight="27"
                                                         FontFamily="Consolas" FontSize="11.5" Padding="7,2"
                                                         LostKeyboardFocus="FlagValue_LostFocus"/>
                                                <TextBlock Grid.Column="3" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="12" Foreground="{DynamicResource BrushWarning}"
                                                           VerticalAlignment="Center" Margin="8,0"
                                                           ToolTip="这个 Flag 不在 RCL 的常见列表内，请确认来源可靠">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsKnown}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Button Grid.Column="4" Style="{StaticResource IconButton}" Width="26" Height="26"
                                                        Tag="{Binding}" Click="DeleteFlag_Click" ToolTip="删除">
                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                               Foreground="{DynamicResource BrushTextMuted}"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="FlagsEmpty" Style="{StaticResource MutedText}" Margin="0,14,0,6"
                                           Text="还没有 FastFlags。可以点「应用预设」快速添加一组常用配置。"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Background="{DynamicResource BrushAccentSoft}"
                                BorderBrush="{DynamicResource BrushAccentBorder}" Padding="16,12" Margin="0,12,0,0">
                            <TextBlock FontSize="12" Foreground="#2E5F9E" TextWrapping="Wrap" LineHeight="19"
                                       Text="FastFlags 会直接改变 Roblox 客户端行为。只使用你理解且信任的 Flag；部分 Flag 可能导致客户端异常或违反 Roblox 使用条款。RCL 会在写入前备份原文件。"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Mods -->
                <ScrollViewer x:Name="PanelMods" Style="{StaticResource PageScroll}" Visibility="Collapsed">
                    <StackPanel Margin="24,18,24,24">
                        <Border Style="{StaticResource Card}" Padding="18,15,18,18">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="模组覆盖" Style="{StaticResource CardTitle}"/>
                                        <Border Style="{StaticResource TagBorder}" Margin="8,0,0,0">
                                            <TextBlock x:Name="ModCountText" Text="0 项" Style="{StaticResource TagText}"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="导入文件" Style="{StaticResource SmallButton}" Height="28" Click="ImportModFile_Click"/>
                                        <Button Content="导入文件夹" Style="{StaticResource SmallButton}" Height="28"
                                                Margin="6,0,0,0" Click="ImportModFolder_Click"/>
                                        <Button Content="打开目录" Style="{StaticResource SmallButton}" Height="28"
                                                Margin="6,0,0,0" Click="OpenModsFolder_Click"/>
                                        <Button Content="还原安装" Style="{StaticResource SmallButton}" Height="28"
                                                Margin="6,0,0,0" Click="RestoreMods_Click"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0"
                                           Text="把 content / PlatformContent 等目录结构放进实例模组目录，启动时按相对路径覆盖到 Roblox 版本目录。首次覆盖的文件会备份到实例 Backup 目录。"/>

                                <Border Style="{StaticResource Divider}"/>

                                <ItemsControl x:Name="ModsList" Margin="0,2">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                           Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Kind}" FontSize="10.5"
                                                               Foreground="{DynamicResource BrushTextMuted}" Margin="0,1,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding CountDisplay}" FontSize="11.5"
                                                           Foreground="{DynamicResource BrushTextSecondary}"
                                                           VerticalAlignment="Center" Margin="10,0,12,0"/>
                                                <CheckBox Grid.Column="3" Content="启用" Style="{StaticResource PclCheckBox}"
                                                          FontSize="11.5" IsChecked="{Binding Enabled, Mode=OneWay}"
                                                          Tag="{Binding}" Click="ModToggle_Click" VerticalAlignment="Center"/>
                                                <Button Grid.Column="4" Style="{StaticResource IconButton}" Width="26" Height="26"
                                                        Tag="{Binding}" Click="DeleteMod_Click" ToolTip="删除">
                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                               Foreground="{DynamicResource BrushTextMuted}"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="ModsEmpty" Style="{StaticResource MutedText}" Margin="0,14,0,6"
                                           Text="还没有模组。可以导入社区模组包，或直接把自己的文件拖进模组目录。"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="18,15" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="安装状态" Style="{StaticResource CardTitle}" Margin="0,0,0,6"/>
                                <TextBlock x:Name="ModStatus" Style="{StaticResource MutedText}"/>
                                <TextBlock x:Name="ModApplied" Style="{StaticResource TinyText}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Launch args -->
                <ScrollViewer x:Name="PanelLaunch" Style="{StaticResource PageScroll}" Visibility="Collapsed">
                    <StackPanel Margin="24,18,24,24">
                        <Border Style="{StaticResource Card}" Padding="20,17,20,18" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="启动参数" Style="{StaticResource CardTitle}"/>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,10"
                                           Text="会追加到 Roblox 命令行。支持空格分隔与引号，例如：-windowMode 1"/>
                                <TextBox x:Name="ArgsBox" Style="{StaticResource PclTextBox}" Height="76"
                                         TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                                         Padding="9,7" FontFamily="Consolas" FontSize="12" TextChanged="ArgsBox_TextChanged"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="启动实例" Style="{StaticResource PrimaryButton}" Height="32" MinWidth="120"
                                            Click="Launch_Click"/>
                                    <Button Content="多开启动" Style="{StaticResource PclButton}" Height="32" MinWidth="110"
                                            Margin="8,0,0,0" Click="LaunchMulti_Click"/>
                                    <TextBlock x:Name="LaunchStatus" Style="{StaticResource TinyText}" VerticalAlignment="Center"
                                               Margin="12,0,0,0"/>
                                </StackPanel>
                             </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="20,17,20,18" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="路径" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="实例目录" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" x:Name="PathInstance" Style="{StaticResource TinyText}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <Button Grid.Column="2" Content="打开" Style="{StaticResource SmallButton}" Height="26"
                                            Click="OpenFolder_Click"/>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="FastFlags" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" x:Name="PathFlags" Style="{StaticResource TinyText}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <Button Grid.Column="2" Content="打开" Style="{StaticResource SmallButton}" Height="26"
                                            Click="OpenFlagsFolder_Click"/>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="模组目录" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" x:Name="PathMods" Style="{StaticResource TinyText}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <Button Grid.Column="2" Content="打开" Style="{StaticResource SmallButton}" Height="26"
                                            Click="OpenModsFolder_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="20,17,20,18">
                            <StackPanel>
                                <TextBlock Text="危险操作" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,10"
                                           Text="删除实例会同时移除它的模组、FastFlags、备份和游玩记录。"/>
                                <Button Content="删除这个实例" Style="{StaticResource DangerButton}" Height="30"
                                        HorizontalAlignment="Left" Click="DeleteInstance_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border x:Name="EmptyPanel" Grid.RowSpan="3" Background="{DynamicResource BrushBackground}" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
                    <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="38"
                               Foreground="{DynamicResource BrushAccentBorder}" HorizontalAlignment="Center"/>
                    <TextBlock Text="还没有实例" Style="{StaticResource PageTitle}" HorizontalAlignment="Center"
                               Margin="0,14,0,6"/>
                    <TextBlock Text="创建一个实例来保存你的版本、模组与启动设置。" Style="{StaticResource MutedText}"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                    <Button Content="新建实例" Style="{StaticResource PrimaryButton}" Height="34" Margin="0,18,0,0"
                            HorizontalAlignment="Center" MinWidth="140" Click="NewInstance_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
