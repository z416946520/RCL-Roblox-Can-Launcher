<UserControl x:Class="RCL.Pages.ToolsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFont}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource BrushSidebar}" BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="0,0,1,0">
            <StackPanel Margin="14,18,12,12">
                <TextBlock Text="工具" Style="{StaticResource PageTitle}" FontSize="18" Margin="2,0,0,12"/>
                <ListBox x:Name="NavList" Style="{StaticResource PclListBox}"
                         ItemContainerStyle="{StaticResource PclListItem}" SelectedIndex="0"
                         SelectionChanged="NavList_SelectionChanged">
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Center" Margin="0,1,9,0"/>
                            <TextBlock Text="服务器浏览器" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Center" Margin="0,1,9,0"/>
                            <TextBlock Text="快捷方式" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Center" Margin="0,1,9,0"/>
                            <TextBlock Text="多开与进程" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Center" Margin="0,1,9,0"/>
                            <TextBlock Text="运行日志" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Center" Margin="0,1,9,0"/>
                            <TextBlock Text="配置导入" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="24,18,24,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="PageHeading" Text="服务器浏览器" Style="{StaticResource PageTitle}"/>
                    <TextBlock x:Name="PageSubheading" Style="{StaticResource PageSubtitle}"
                               Text="查看公开服务器并直接加入；加入操作使用当前选中的实例。"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="目标实例" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="TargetInstanceCombo" Style="{StaticResource PclComboBox}" Width="170" Height="30"
                              DisplayMemberPath="Name"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <!-- Servers -->
                <ScrollViewer x:Name="PanelServers" Style="{StaticResource PageScroll}">
                    <StackPanel Margin="24,6,24,24">
                        <Border Style="{StaticResource Card}" Padding="20,17,20,18" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="查询游戏" Style="{StaticResource CardTitle}"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="PlaceBox" Style="{StaticResource PclTextBox}" Height="32"
                                             Padding="9,4" KeyDown="PlaceBox_KeyDown"/>
                                    <Button Grid.Column="1" Content="查询" Style="{StaticResource PrimaryButton}" Height="32"
                                            MinWidth="90" Margin="8,0,0,0" Click="Query_Click"/>
                                </Grid>
                                <TextBlock Style="{StaticResource TinyText}" Margin="1,6,0,0"
                                           Text="支持完整游戏链接、placeId=123 或纯数字。"/>
                                <Grid Margin="0,14,0,0" x:Name="GameInfoPanel" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="60" Height="60" CornerRadius="6" Background="{DynamicResource BrushHover}">
                                        <Image x:Name="GameThumb" Stretch="UniformToFill" Width="60" Height="60"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="GameName" FontSize="15" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="GameMeta" Style="{StaticResource MutedText}" FontSize="11.5"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="QueryStatus" Style="{StaticResource TinyText}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="18,15,18,15">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="公开服务器" Style="{StaticResource CardTitle}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Border Style="{StaticResource TagBorder}" Margin="0,0,6,0">
                                            <TextBlock x:Name="ServerCountText" Text="0 个" Style="{StaticResource TagText}"/>
                                        </Border>
                                        <Button Content="刷新" Style="{StaticResource SmallButton}" Height="26" Padding="9,0"
                                                Click="RefreshServers_Click"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,12,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="服务器 ID" Style="{StaticResource TinyText}"/>
                                    <TextBlock Grid.Column="1" Text="玩家" Style="{StaticResource TinyText}"/>
                                    <TextBlock Grid.Column="2" Text="Ping" Style="{StaticResource TinyText}"/>
                                    <TextBlock Grid.Column="3" Text="FPS" Style="{StaticResource TinyText}"/>
                                </Grid>
                                <Border Style="{StaticResource Divider}" Margin="0,2,0,4"/>
                                <ItemsControl x:Name="ServersList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Id}" FontFamily="Consolas" FontSize="11"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Style="{StaticResource TinyText}" Text="公开服务器"
                                                               Margin="0,1,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding PlayersDisplay}" FontSize="12"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding PingDisplay}" FontSize="12"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding FpsDisplay}" FontSize="12"
                                                           VerticalAlignment="Center"/>
                                                <Button Grid.Column="4" Content="加入" Style="{StaticResource SmallButton}"
                                                        Height="27" MinWidth="58" Tag="{Binding}" Click="JoinServer_Click"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="ServersEmpty" Style="{StaticResource MutedText}" Margin="0,12,0,4"
                                           Text="查询一个游戏后，这里会列出公开服务器。"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Shortcuts -->
                <ScrollViewer x:Name="PanelShortcuts" Style="{StaticResource PageScroll}" Visibility="Collapsed">
                    <StackPanel Margin="24,6,24,24">
                        <Border Style="{StaticResource Card}" Padding="20,17,20,18" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="创建桌面快捷方式" Style="{StaticResource CardTitle}"/>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,12"
                                           Text="快捷方式会带上实例 ID；双击后直接启动该实例，可附带最近一次加入的游戏。"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="为当前实例创建" Style="{StaticResource PrimaryButton}" Height="32"
                                            Click="CreateShortcut_Click"/>
                                    <Button Content="打开桌面目录" Style="{StaticResource GhostButton}" Height="32"
                                            Margin="8,0,0,0" Click="OpenDesktop_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="ShortcutStatus" Style="{StaticResource TinyText}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="20,17,20,18">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="已有的 RCL 快捷方式" Style="{StaticResource CardTitle}"/>
                                    <TextBlock x:Name="ShortcutCount" Style="{StaticResource TinyText}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <ItemsControl x:Name="ShortcutsList" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="12.5"/>
                                                    <TextBlock Text="{Binding FullName}" FontSize="10.5"
                                                               Foreground="{DynamicResource BrushTextMuted}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="删除" Style="{StaticResource SmallButton}"
                                                        Height="26" Tag="{Binding}" Click="DeleteShortcut_Click"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="ShortcutsEmpty" Style="{StaticResource MutedText}" Margin="0,10,0,4"
                                           Text="桌面上还没有 RCL 快捷方式。"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Multi-instance -->
                <ScrollViewer x:Name="PanelProcesses" Style="{StaticResource PageScroll}" Visibility="Collapsed">
                    <StackPanel Margin="24,6,24,24">
                        <Border Style="{StaticResource Card}" Padding="18,15,18,16" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="多开状态" Style="{StaticResource CardTitle}"/>
                                        <TextBlock x:Name="MultiStatus" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button Content="清理空闲槽位" Style="{StaticResource SmallButton}" Height="28"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Click="CleanupSlots_Click"/>
                                </Grid>
                                <Border Style="{StaticResource Divider}"/>
                                <ItemsControl x:Name="SlotsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Target}" FontSize="10.5" FontFamily="Consolas"
                                                               Foreground="{DynamicResource BrushTextMuted}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <Border Grid.Column="2" Style="{StaticResource TagBorder}"
                                                        Background="#E8F5EC" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding State}" FontSize="10" Foreground="#1F8A4C"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="SlotsEmpty" Style="{StaticResource MutedText}" Margin="0,10,0,4"
                                           Text="还没有创建多开槽位。以多开方式启动实例后会自动建立。"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="18,15,18,16">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Roblox 进程" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Style="{StaticResource TinyText}" Margin="0,2,0,0"
                                                   Text="包含 RCL 启动的会话与系统中其他客户端。结束进程会丢失未保存进度。"/>
                                    </StackPanel>
                                    <Button Content="刷新" Style="{StaticResource SmallButton}" Height="27"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Click="RefreshProcesses_Click"/>
                                </Grid>
                                <Border Style="{StaticResource Divider}"/>
                                <ItemsControl x:Name="ProcessesList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Display}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource TinyText}" Margin="0,1,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Memory}" FontSize="11.5"
                                                           VerticalAlignment="Center" Margin="10,0,10,0"
                                                           Foreground="{DynamicResource BrushTextSecondary}"/>
                                                <Button Grid.Column="2" Content="结束" Style="{StaticResource SmallButton}"
                                                        Height="26" Tag="{Binding}" Click="KillProcess_Click"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="ProcessesEmpty" Style="{StaticResource MutedText}" Margin="0,10,0,4"
                                           Text="当前没有运行中的 Roblox 进程。"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Logs -->
                <ScrollViewer x:Name="PanelLogs" Style="{StaticResource PageScroll}" Visibility="Collapsed">
                    <StackPanel Margin="24,6,24,24">
                        <Border Style="{StaticResource Card}" Padding="18,15,18,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="RCL 日志" Style="{StaticResource CardTitle}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="刷新" Style="{StaticResource SmallButton}" Height="27" Padding="9,0"
                                                Click="RefreshLog_Click"/>
                                        <Button Content="打开日志文件" Style="{StaticResource SmallButton}" Height="27"
                                                Margin="6,0,0,0" Click="OpenLogFile_Click"/>
                                        <Button Content="Roblox 日志目录" Style="{StaticResource SmallButton}" Height="27"
                                                Margin="6,0,0,0" Click="OpenRobloxLogs_Click"/>
                                    </StackPanel>
                                </Grid>
                                <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                         Height="380" FontFamily="Consolas" FontSize="11.5" Padding="10"
                                         Background="#F7F8FA" BorderBrush="{DynamicResource BrushBorder}"
                                         Foreground="{DynamicResource BrushTextSecondary}"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Import -->
                <ScrollViewer x:Name="PanelImport" Style="{StaticResource PageScroll}" Visibility="Collapsed">
                    <StackPanel Margin="24,6,24,24">
                        <Border Style="{StaticResource Card}" Padding="20,17,20,18" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="从其他启动器导入 FastFlags" Style="{StaticResource CardTitle}"/>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,12"
                                           Text="RCL 会扫描 Bloxstrap、Voidstrap、Froststrap、Fishstrap 的默认配置目录。导入后写入目标实例，同名 Flag 会被覆盖。"/>
                                <ItemsControl x:Name="ImportsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding}" FontSize="11.5" FontFamily="Consolas"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="导入" Style="{StaticResource SmallButton}"
                                                        Height="26" Tag="{Binding}" Click="ImportOne_Click"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="ImportsEmpty" Style="{StaticResource MutedText}" Margin="0,10,0,4"
                                           Text="没有找到其他启动器的 FastFlags 文件。"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="全部导入到目标实例" Style="{StaticResource PrimaryButton}" Height="30"
                                            Click="ImportAll_Click"/>
                                    <Button Content="打开 RCL 数据目录" Style="{StaticResource GhostButton}" Height="30"
                                            Margin="8,0,0,0" Click="OpenDataFolder_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="ImportStatus" Style="{StaticResource TinyText}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Background="{DynamicResource BrushAccentSoft}"
                                BorderBrush="{DynamicResource BrushAccentBorder}" Padding="16,13">
                            <TextBlock FontSize="12" Foreground="#2E5F9E" TextWrapping="Wrap" LineHeight="19"
                                       Text="导入只读取其他启动器目录里的 ClientAppSettings.json，不会修改它们。导入结果可以在「实例 → FastFlags」里逐条检查或删除。"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
