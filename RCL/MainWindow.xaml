<Window x:Class="RCL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RCL - Roblox Launcher"
        Icon="Assets/RCL.ico"
        Width="1140" Height="730" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" FontFamily="{DynamicResource AppFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        ResizeMode="CanMinimize" SizeChanged="Window_SizeChanged">
    <Grid x:Name="RootGrid" Margin="10">
        <Border x:Name="Shell" CornerRadius="6" Background="{DynamicResource BrushBackground}"
                BorderBrush="#33000000" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.20" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- PCL2 title bar -->
                <Border x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource BrushTitleBar}"
                        CornerRadius="6,6,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Path Grid.Column="0" Data="M26,29 v-25 h6 a7,7 180 0 1 0,14 h-6 M37,18 L47,29 M62.5,6.5 a10,11.5 180 1 0 0,18 M71,2.5 v24.5 h13.5"
                              Stroke="{DynamicResource BrushTitleForeground}" StrokeThickness="2.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Stretch="Uniform" Width="58" Height="26" Margin="19,0,0,0"
                              HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <RadioButton x:Name="TabLaunch" Style="{StaticResource TitleTab}" Tag="&#xE768;"
                                         Content="启动" GroupName="MainTabs" IsChecked="True" Checked="Tab_Checked"/>
                            <RadioButton x:Name="TabInstances" Style="{StaticResource TitleTab}" Tag="&#xE8F1;"
                                         Content="实例" GroupName="MainTabs" Checked="Tab_Checked"/>
                            <RadioButton x:Name="TabDownload" Style="{StaticResource TitleTab}" Tag="&#xE896;"
                                         Content="下载" GroupName="MainTabs" Checked="Tab_Checked"/>
                            <RadioButton x:Name="TabQuickLaunch" Style="{StaticResource TitleTab}" Tag="&#xE71B;"
                                         Content="快捷启动" GroupName="MainTabs" Checked="Tab_Checked"/>
                            <RadioButton x:Name="TabTools" Style="{StaticResource TitleTab}" Tag="&#xE90F;"
                                         Content="工具" GroupName="MainTabs" Checked="Tab_Checked"/>
                            <RadioButton x:Name="TabSettings" Style="{StaticResource TitleTab}" Tag="&#xE713;"
                                         Content="设置" GroupName="MainTabs" Checked="Tab_Checked"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="0,0,12,0">
                            <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="最小化">
                                <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                           Foreground="{DynamicResource BrushTitleForeground}"/>
                            </Button>
                            <Button Style="{StaticResource CloseCaptionButton}" Click="Close_Click" ToolTip="关闭"
                                    Margin="4,0,0,0">
                                <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                           Foreground="{DynamicResource BrushTitleForeground}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Page area -->
                <Grid Grid.Row="1" ClipToBounds="True">
                    <Image x:Name="Wallpaper" Stretch="UniformToFill" IsHitTestVisible="False"
                           Opacity="0.22" Visibility="Collapsed"/>
                    <Border x:Name="WallpaperDim" Background="#000000" Opacity="0"
                            IsHitTestVisible="False" Visibility="Collapsed"/>
                    <ContentControl x:Name="PageHost"/>

                    <Border x:Name="ToastBorder" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                            Margin="18,0,0,16" Background="#F7FFFFFF" BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="5" Padding="13,9" MaxWidth="660"
                            Visibility="Collapsed" Opacity="0" Panel.ZIndex="20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.14"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ToastIcon" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" Foreground="{DynamicResource BrushAccent}"
                                       VerticalAlignment="Center" Margin="0,0,9,0"/>
                            <TextBlock x:Name="ToastText" FontSize="12.5" TextWrapping="Wrap"
                                       Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- PCL2-style custom resize handles (the window is transparent, so there is no native frame) -->
        <Rectangle Height="8" VerticalAlignment="Top" Margin="12,0,12,0" Fill="#01000000" Cursor="SizeNS"
                   Panel.ZIndex="100" MouseLeftButtonDown="ResizeTop"/>
        <Rectangle Height="8" VerticalAlignment="Bottom" Margin="12,0,12,0" Fill="#01000000" Cursor="SizeNS"
                   Panel.ZIndex="100" MouseLeftButtonDown="ResizeBottom"/>
        <Rectangle Width="8" HorizontalAlignment="Left" Margin="0,12,0,12" Fill="#01000000" Cursor="SizeWE"
                   Panel.ZIndex="100" MouseLeftButtonDown="ResizeLeft"/>
        <Rectangle Width="8" HorizontalAlignment="Right" Margin="0,12,0,12" Fill="#01000000" Cursor="SizeWE"
                   Panel.ZIndex="100" MouseLeftButtonDown="ResizeRight"/>
        <Rectangle Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="#01000000"
                   Cursor="SizeNWSE" Panel.ZIndex="101" MouseLeftButtonDown="ResizeTopLeft"/>
        <Rectangle Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="#01000000"
                   Cursor="SizeNESW" Panel.ZIndex="101" MouseLeftButtonDown="ResizeTopRight"/>
        <Rectangle Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="#01000000"
                   Cursor="SizeNESW" Panel.ZIndex="101" MouseLeftButtonDown="ResizeBottomLeft"/>
        <Rectangle Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="#01000000"
                   Cursor="SizeNWSE" Panel.ZIndex="101" MouseLeftButtonDown="ResizeBottomRight"/>
    </Grid>
</Window>
